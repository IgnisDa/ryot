{
	"name": "@ryot/fitness-plugin",
	"private": true,
	"exports": {
		".": {
			"types": "./manifest.ts",
			"default": "./manifest.ts"
		},
		"./import-sources": {
			"types": "./import-sources.ts",
			"default": "./import-sources.ts"
		},
		"./query-recipes": {
			"types": "./query-recipes.ts",
			"default": "./query-recipes.ts"
		},
		"./schemas/property-schemas": {
			"types": "./backend/schemas/property-schemas.ts",
			"default": "./backend/schemas/property-schemas.ts"
		}
	},
	"scripts": {
		"build": "ryot plugin build",
		"test": "bun --bun run vitest run",
		"check": "tsc && oxfmt . --write && oxlint . --type-aware --fix"
	},
	"dependencies": {
		"@ryot/config": "workspace:*",
		"@ryot/contract": "workspace:*",
		"@ryot/ryotql": "workspace:*",
		"@ryot/ryotql-recipes": "workspace:*",
		"@ryot/sandbox-sdk": "workspace:*",
		"@ryot/ts-utils": "workspace:*",
		"effect": "4.0.0-rc.111"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.0-beta.107",
		"@ryot/cli": "workspace:*",
		"@ryot/testing": "workspace:*",
		"bun-types": "1.4.0",
		"vitest": "4.1.9"
	}
}
