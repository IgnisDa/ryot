{
	"name": "@ryot/app-backend",
	"main": "src/main.ts",
	"scripts": {
		"dev": "bun run scripts/develop.ts",
		"db:generate": "bun --bun drizzle-kit generate",
		"purity:check": "bun run scripts/check-kernel-purity.ts",
		"test": "bun run sandbox:compile-runner && bun --bun run vitest run",
		"sandbox:compile-runner": "bun run scripts/compile-sandbox-runner.ts",
		"run-migration": "bun run sandbox:compile-runner && RUN_MIGRATION_ONLY=true bun run src/main.ts",
		"sandbox:check-runner": "deno check --config src/lib/infrastructure/sandbox-runtime/deno.json src/lib/infrastructure/sandbox-runtime/runner-source.sandbox.ts",
		"check": "bun run purity:check && bun run sandbox:compile-runner && bun run sandbox:check-runner && tsc && oxfmt . --write && oxlint . --type-aware --fix",
		"build": "bun run sandbox:compile-runner && bun build src/main.ts --outdir dist --target bun --sourcemap && bun build scripts/prepare-sandbox-runtime.ts --outdir dist --target bun --sourcemap && bun build scripts/smoke-compiler-worker.ts --outdir dist --target bun --sourcemap"
	},
	"dependencies": {
		"@better-auth/api-key": "1.6.15",
		"@better-auth/core": "1.6.15",
		"@better-auth/expo": "1.6.15",
		"@better-auth/redis-storage": "1.6.15",
		"@effect/opentelemetry": "4.0.0-beta.102",
		"@effect/platform-bun": "4.0.0-beta.102",
		"@effect/sql-pg": "4.0.0-beta.102",
		"@opentelemetry/api": "1.9.1",
		"@ryot/config": "workspace:*",
		"@ryot/contract": "workspace:*",
		"@ryot/fitness-plugin": "workspace:*",
		"@ryot/media-fitness": "workspace:*",
		"@ryot/plugin-kit": "workspace:*",
		"@ryot/query-engine": "workspace:*",
		"@ryot/sandbox-compiler": "workspace:*",
		"@ryot/sandbox-sdk": "workspace:*",
		"@ryot/ts-utils": "workspace:*",
		"better-auth": "1.6.15",
		"drizzle-orm": "0.45.2",
		"effect": "4.0.0-beta.102",
		"fast-xml-parser": "5.8.0",
		"ioredis": "5.11.1",
		"nodemailer": "8.0.10",
		"papaparse": "5.5.3",
		"pg": "8.21.0",
		"unzipit": "2.0.3"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.0-beta.102",
		"@ryot/testing": "workspace:*",
		"@types/ioredis": "5.0.0",
		"@types/nodemailer": "8.0.0",
		"@types/papaparse": "5.5.2",
		"@types/pg": "8.20.0",
		"bun-types": "1.3.14",
		"drizzle-kit": "0.31.10",
		"vitest": "4.1.9"
	}
}
