{
	"name": "@ryot/app-backend",
	"main": "src/main.ts",
	"scripts": {
		"dev": "bun run scripts/develop.ts",
		"db:generate": "bun --bun drizzle-kit generate",
		"purity:check": "bun run scripts/check-kernel-purity.ts",
		"test": "bun run sandbox:compile-runner && bun --bun run vitest run",
		"sandbox:compile-runner": "bun run scripts/compile-sandbox-runner.ts",
		"run-migration": "bun run sandbox:compile-runner && RUN_MIGRATION_ONLY=true bun run src/main.ts",
		"sandbox:check-runner": "deno check --config src/lib/infrastructure/sandbox-runtime/deno.json src/lib/infrastructure/sandbox-runtime/runner-source.sandbox.ts",
		"check": "bun run purity:check && bun run sandbox:compile-runner && bun run sandbox:check-runner && tsc && oxfmt . --write && oxlint . --type-aware --fix",
		"build": "bun run sandbox:compile-runner && bun build src/main.ts --outdir dist --target bun --sourcemap --define process.env.UNKEY_ROOT_KEY=\"\\\"${UNKEY_ROOT_KEY:-}\\\"\" && bun build scripts/prepare-sandbox-runtime.ts --outdir dist --target bun --sourcemap && bun build scripts/smoke-compiler-worker.ts --outdir dist --target bun --sourcemap"
	},
	"dependencies": {
		"@better-auth/api-key": "1.7.0-rc.6",
		"@better-auth/core": "1.7.0-rc.6",
		"@better-auth/expo": "1.7.0-rc.6",
		"@better-auth/redis-storage": "1.7.0-rc.6",
		"@dicebear/core": "10.6.0",
		"@dicebear/styles": "10.5.0",
		"@effect/opentelemetry": "4.0.0-beta.107",
		"@effect/platform-bun": "4.0.0-beta.107",
		"@effect/sql-pg": "4.0.0-beta.107",
		"@opentelemetry/api": "1.9.1",
		"@react-email/components": "1.0.7",
		"@ryot/config": "workspace:*",
		"@ryot/contract": "workspace:*",
		"@ryot/fitness-plugin": "workspace:*",
		"@ryot/media-plugin": "workspace:*",
		"@ryot/ryotql-recipes": "workspace:*",
		"@ryot/sandbox-compiler": "workspace:*",
		"@ryot/sandbox-sdk": "workspace:*",
		"@ryot/transactional": "workspace:*",
		"@ryot/ts-utils": "workspace:*",
		"@unkey/api": "2.3.5",
		"better-auth": "1.7.0-rc.6",
		"drizzle-orm": "1.0.0-rc.5-169397b",
		"effect": "4.0.0-rc.111",
		"fflate": "0.8.3",
		"ioredis": "5.11.1",
		"nodemailer": "8.0.10",
		"pg": "8.21.0",
		"react": "19.2.4",
		"react-dom": "19.2.4"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.0-beta.107",
		"@ryot/ryotql": "workspace:*",
		"@ryot/testing": "workspace:*",
		"@types/ioredis": "5.0.0",
		"@types/nodemailer": "8.0.0",
		"@types/pg": "8.20.0",
		"bun-types": "1.4.0",
		"dotenv": "17.3.1",
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"vitest": "4.1.9"
	}
}
