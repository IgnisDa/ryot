{
	"name": "@ryot/app-backend",
	"main": "src/main.ts",
	"imports": {
		"#*": [
			"./src/*.ts"
		]
	},
	"exports": {
		".": "./src/main.ts"
	},
	"scripts": {
		"dev": "bun run --watch src/main.ts",
		"db:generate": "bun --bun drizzle-kit generate",
		"test": "bun --bun run vitest run --config vitest.config.ts",
		"check": "tsc && oxfmt . --write && oxlint . --type-aware --fix",
		"run-migration": "RUN_LEGACY_BOOTSTRAP_ONLY=true bun run src/main.ts",
		"build": "bun build src/main.ts --outdir dist --target bun --sourcemap",
		"populate-sandbox-cache": "POPULATE_SANDBOX_CACHE_ONLY=true bun run src/main.ts"
	},
	"dependencies": {
		"@better-auth/api-key": "1.6.15",
		"@better-auth/redis-storage": "1.6.15",
		"@effect/cluster": "0.59.0",
		"@effect/experimental": "0.60.0",
		"@effect/platform": "0.96.2",
		"@effect/platform-bun": "0.90.0",
		"@effect/sql-pg": "0.52.1",
		"@effect/workflow": "0.18.2",
		"@ryot/contract": "workspace:*",
		"@ryot/query-engine": "workspace:*",
		"@ryot/ts-utils": "workspace:*",
		"better-auth": "1.6.15",
		"drizzle-orm": "0.45.2",
		"effect": "3.21.4",
		"fast-xml-parser": "5.8.0",
		"fast-xml-validator": "1.1.0",
		"ioredis": "5.11.1",
		"nodemailer": "8.0.10",
		"papaparse": "5.5.3",
		"pg": "8.21.0",
		"unzipit": "2.0.3"
	},
	"devDependencies": {
		"@effect/vitest": "0.29.0",
		"@types/ioredis": "5.0.0",
		"@types/nodemailer": "8.0.0",
		"@types/papaparse": "5.5.2",
		"@types/pg": "8.20.0",
		"bun-types": "1.3.14",
		"drizzle-kit": "0.31.10",
		"typescript": "7.0.2",
		"vitest": "4.1.9"
	}
}
