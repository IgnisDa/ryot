{
	"$schema": "https://raw.githubusercontent.com/Effect-TS/tsgo/refs/heads/main/schema.json",
	"compilerOptions": {
		"noEmit": true,
		"strict": true,
		"lib": ["ESNext"],
		"target": "ES2022",
		"module": "ESNext",
		"skipLibCheck": true,
		"types": ["bun-types"],
		"moduleResolution": "bundler",
		"paths": { "#*": ["./src/*"] },
		"noUncheckedIndexedAccess": true,
		"plugins": [{ "name": "@effect/language-service" }]
	}
}
