{
	"name": "@ryot-app/browser-extension",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build-chrome": "wxt zip -b chrome",
		"build-firefox": "wxt zip -b firefox",
		"build": "bun run build-chrome && bun run build-firefox",
		"check": "wxt prepare && bun --check && bun fmt . --write && oxlint . --fix"
	},
	"dependencies": {
		"@ryot-app/contract": "workspace:*",
		"@ryot-app/media-plugin": "workspace:*",
		"@ryot-app/plugin-kit": "workspace:*",
		"@ryot-app/ts-utils": "workspace:*",
		"@tailwindcss/vite": "4.3.4",
		"effect": "4.1.0",
		"lucide-react": "0.563.0",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"tailwindcss": "4.3.4",
		"ts-pattern": "5.9.0"
	},
	"devDependencies": {
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@wxt-dev/auto-icons": "1.1.0",
		"@wxt-dev/module-react": "1.1.5",
		"vite-tsconfig-paths": "6.1.1",
		"wxt": "0.21.5"
	}
}
