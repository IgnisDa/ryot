{
	"include": ["**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
	"compilerOptions": {
		"baseUrl": ".",
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"jsx": "react-jsx",
		"module": "ESNext",
		"target": "es2022",
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"moduleResolution": "bundler",
		"forceConsistentCasingInFileNames": true,
		"rootDirs": [".", "./.react-router/types"],
		"lib": ["DOM", "DOM.Iterable", "ES2022", "WebWorker"],
		"types": ["@react-router/node", "vite/client", "vite-plugin-pwa/client"],
		"paths": {
			"~/*": ["./app/*"],
			"@ryot/graphql/*": ["../../packages/graphql/src/*"],
			"@ryot/ts-utils/*": ["../../packages/ts-utils/src/*"],
			"@ryot/generated/*": ["../../packages/generated/src/*"]
		}
	}
}
