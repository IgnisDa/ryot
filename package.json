{
	"name": "@ryot-app/root",
	"license": "Elastic-2.0",
	"workspaces": [
		"apps/*",
		"kernel/*",
		"packages/*",
		"plugins/*",
		"e2e*"
	],
	"scripts": {
		"dev": "turbo dev",
		"test": "turbo test",
		"build": "turbo build",
		"prepare": "effect-tsgo patch --no-typescript --oxlint",
		"docker:up": "docker compose -f ci/dev/docker-compose.yml up",
		"docker:down": "docker compose -f ci/dev/docker-compose.yml down",
		"check": "node --test ci/oxlint/ryot-plugin.test.mjs ci/oxlint/import-boundaries.test.mjs && turbo check && bun --check"
	},
	"devDependencies": {
		"@effect/tsgo": "0.53.1",
		"bun-types": "1.4.4",
		"eslint-plugin-perfectionist": "5.12.1",
		"oxlint": "1.85.0",
		"oxlint-tsgolint": "7.0.2003",
		"tsconfig-moon": "1.4.2",
		"turbo": "2.10.12"
	},
	"packageManager": "bun@1.4.4"
}
