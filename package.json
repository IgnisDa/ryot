{
	"name": "@ryot-app/root",
	"license": "Elastic-2.0",
	"workspaces": [
		"apps/*",
		"kernel/*",
		"migrations/*",
		"packages/*",
		"plugins/*",
		"e2e*"
	],
	"scripts": {
		"dev": "turbo dev",
		"test": "turbo test",
		"build": "turbo build",
		"check": "turbo check",
		"prepare": "effect-tsgo patch",
		"docker:up": "docker compose -f ci/dev/docker-compose.yml up",
		"docker:down": "docker compose -f ci/dev/docker-compose.yml down"
	},
	"devDependencies": {
		"@effect/tsgo": "0.45.0",
		"bun-types": "1.4.0",
		"eslint-plugin-perfectionist": "5.11.0",
		"oxfmt": "0.52.0",
		"oxlint": "1.67.0",
		"oxlint-tsgolint": "0.23.0",
		"tsconfig-moon": "1.4.2",
		"turbo": "2.10.12",
		"typescript": "7.0.2"
	},
	"overrides": {
		"@effect/platform-node-shared": "4.0.0-rc.116",
		"lightningcss": "1.30.1"
	},
	"packageManager": "bun@1.4.0"
}
