{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"dev": { "cache": false, "persistent": true },
		"check": { "dependsOn": ["^check"], "outputLogs": "errors-only" },
		"test": { "outputLogs": "errors-only", "dependsOn": ["^build", "^check", "^test"] },
		"build": {
			"dependsOn": ["^build"],
			"outputLogs": "errors-only",
			"outputs": ["out/**", "dist/**", "build/**", ".vitepress/dist/**"]
		}
	}
}
