{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["tsconfig.options.json", "bunfig.toml"],
	"tasks": {
		"transit": { "dependsOn": ["^transit"] },
		"dev": { "cache": false, "persistent": true },
		"test": { "outputLogs": "errors-only", "dependsOn": ["^build", "^check", "^test"] },
		"build": {
			"dependsOn": ["^build"],
			"outputLogs": "errors-only",
			"env": ["UNKEY_ROOT_KEY", "RYOT_VERSION"],
			"outputs": ["out/**", "dist/**", "build/**", ".vitepress/dist/**"]
		},
		"check": {
			"outputLogs": "errors-only",
			"dependsOn": ["^check", "^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/.oxlintrc.json",
				"$TURBO_ROOT$/ci/oxlint/**"
			]
		}
	},
	"globalPassThroughEnv": [
		"CARGO_HOME",
		"RUSTUP_HOME",
		"DOCKER_HOST",
		"TEST_DATABASE_URL",
		"TESTCONTAINERS_HOST_OVERRIDE",
		"TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE"
	]
}
