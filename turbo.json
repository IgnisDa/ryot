{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		"tsconfig.options.json",
		"bunfig.toml"
	],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"outputLogs": "errors-only",
			"dependsOn": [
				"^build",
				"^check",
				"^test"
			]
		},
		"build": {
			"dependsOn": [
				"^build"
			],
			"outputLogs": "errors-only",
			"env": [
				"UNKEY_ROOT_KEY",
				"RYOT_VERSION"
			],
			"outputs": [
				"out/**",
				"dist/**",
				"build/**",
				".vitepress/dist/**"
			]
		},
		"check": {
			"outputLogs": "errors-only",
			"dependsOn": [
				"^check",
				"^build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/.oxlintrc.json",
				"$TURBO_ROOT$/ci/oxlint/**"
			]
		},
		"@ryot-app/e2e#test": {
			"outputLogs": "errors-only",
			"dependsOn": [
				"^build",
				"^check",
				"^test"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/apps/server/**",
				"$TURBO_ROOT$/kernel/**",
				"$TURBO_ROOT$/packages/**",
				"$TURBO_ROOT$/plugins/**",
				"!$TURBO_ROOT$/**/node_modules/**",
				"!$TURBO_ROOT$/**/dist/**",
				"!$TURBO_ROOT$/**/.turbo/**",
				"!$TURBO_ROOT$/**/{.DS_Store,.env,*.tsbuildinfo}",
				"!$TURBO_ROOT$/apps/server/{client,logs,plugins,sandboxd,storage,tmp,work}/**",
				"!$TURBO_ROOT$/kernel/client/{android,ios}/**",
				"!$TURBO_ROOT$/kernel/sandbox/native/{payload,target}/**"
			]
		}
	},
	"globalPassThroughEnv": [
		"CARGO_HOME",
		"RUSTUP_HOME",
		"DOCKER_HOST",
		"TEST_DATABASE_URL",
		"TESTCONTAINERS_HOST_OVERRIDE",
		"TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE"
	]
}
