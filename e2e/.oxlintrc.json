{
	"extends": ["../.oxlintrc.json"],
	"$schema": "../node_modules/oxlint/configuration_schema.json",
	"overrides": [
		{
			"files": ["src/api/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "bun:test",
								"message": "Import the runner surface from ~/support/effect-test."
							},
							{
								"name": "@voila.dev/effect-bun-test",
								"message": "Import the runner surface from ~/support/effect-test."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/browser/**"],
			"rules": {
				"no-restricted-properties": [
					"error",
					{ "property": "toSorted", "message": "Use sortBy from @ryot-app/ts-utils instead." },
					{
						"property": "make",
						"object": "Activity",
						"message": "Create activities with makeActivity from kernel/backend/src/platform/workflow/scope.ts."
					}
				]
			}
		}
	]
}
