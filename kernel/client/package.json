{
	"name": "@ryot-app/kernel-client",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"generate-routes": "tsr generate",
		"test": "bun ../../packages/testing/src/run-client-tests.ts --timeout=12000",
		"sync": "bun run build && cap sync",
		"ios": "bun run sync && cap run ios",
		"android": "bun run sync && cap run android",
		"generate-assets": "bun tooling/generate-assets.ts",
		"check": "bun --check && bun fmt . --write && oxlint . --fix",
		"dev": "RYOT_VERSION=$(git describe --tags --always --dirty) vite dev --port 3005",
		"build": "RYOT_VERSION=${RYOT_VERSION:-$(git describe --tags --always --dirty)} vite build"
	},
	"dependencies": {
		"@aparajita/capacitor-secure-storage": "8.0.1",
		"@better-auth/oauth-provider": "1.7.16",
		"@capacitor-community/keep-awake": "8.0.1",
		"@capacitor/android": "8.6.0",
		"@capacitor/app": "8.1.2",
		"@capacitor/browser": "8.0.5",
		"@capacitor/core": "8.6.0",
		"@capacitor/file-transfer": "2.0.6",
		"@capacitor/filesystem": "8.1.5",
		"@capacitor/haptics": "8.0.2",
		"@capacitor/ios": "8.6.0",
		"@capacitor/keyboard": "8.0.6",
		"@capacitor/local-notifications": "8.3.1",
		"@capacitor/share": "8.0.3",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/lora": "5.3.0",
		"@noble/hashes": "2.4.0",
		"@ryot-app/contract": "workspace:*",
		"@ryot-app/plugin-client-contract": "workspace:*",
		"@ryot-app/plugin-client-sdk": "workspace:*",
		"@ryot-app/plugin-ui-sdk": "workspace:*",
		"@ryot-app/ryotql": "workspace:*",
		"@ryot-app/ryotql-recipes": "workspace:*",
		"@ryot-app/ts-utils": "workspace:*",
		"@tailwindcss/vite": "4.3.4",
		"@tanstack/react-form": "2.0.0-alpha.3",
		"@tanstack/react-router": "1.170.46",
		"better-auth": "1.7.16",
		"clsx": "2.1.1",
		"effect": "4.1.2",
		"motion": "14.9.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwindcss": "4.3.4",
		"uqr": "0.1.3"
	},
	"devDependencies": {
		"bun-types": "1.4.4",
		"@capacitor/assets": "4.0.0",
		"@capacitor/cli": "8.6.0",
		"@effect/platform-bun": "4.1.2",
		"@ryot-app/ryotql": "workspace:*",
		"@ryot-app/testing": "workspace:*",
		"@tanstack/devtools-vite": "0.8.6",
		"@tanstack/router-cli": "1.167.46",
		"@tanstack/router-plugin": "1.168.48",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
