# Every op registered in a sandbox isolate. The build fails when this list differs from the registered ops.
# `allow` ops keep their implementation; `deny` ops are replaced by a stub that throws.
deny op_abort_wasm_streaming
deny op_add
deny op_add_async
deny op_add_main_module_handler
allow op_cancel_handle
deny op_cancel_read
deny op_close
deny op_compile_function
allow op_current_user_call_site
deny op_decode
deny op_deserialize
deny op_destructure_error
allow op_dispatch_exception
allow op_drain_pending_rejections
deny op_encode
deny op_encode_binary_string
deny op_error_async
deny op_error_async_deferred
deny op_eval_context
allow op_event_loop_has_more_work
deny op_get_constructor_name
allow op_get_ext_import_meta_proto
allow op_get_extras_binding_object
deny op_get_non_index_property_names
deny op_get_promise_details
deny op_get_proxy_details
allow op_immediate_check
deny op_import_sync
deny op_import_sync_with_source
deny op_is_any_array_buffer
deny op_is_arguments_object
deny op_is_array_buffer
deny op_is_array_buffer_view
deny op_is_async_function
deny op_is_big_int_object
deny op_is_boolean_object
deny op_is_boxed_primitive
deny op_is_data_view
deny op_is_date
