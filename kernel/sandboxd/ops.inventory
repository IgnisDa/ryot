deny op_is_module_namespace_object
deny op_is_native_error
deny op_is_number_object
deny op_is_promise
deny op_is_proxy
deny op_is_reg_exp
deny op_is_set
deny op_is_set_iterator
deny op_is_shared_array_buffer
deny op_is_string_object
deny op_is_symbol_object
deny op_is_terminal
allow op_is_typed_array
deny op_is_weak_map
deny op_is_weak_set
deny op_lazy_load_esm
deny op_leak_tracing_enable
deny op_leak_tracing_get
deny op_leak_tracing_get_all
deny op_leak_tracing_submit
