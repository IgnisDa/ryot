{
	"extends": "../tsconfig.options.json",
	"compilerOptions": {
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"emitDeclarationOnly": false,
		"strict": true,
		"noEmit": true,
		"outDir": "dist",
		"target": "ES2022",
		"module": "ESNext",
		"skipLibCheck": true,
		"types": ["bun-types"],
		"esModuleInterop": true,
		"lib": ["ESNext", "DOM"],
		"moduleResolution": "bundler",
		"paths": { "~/*": ["./src/*"] },
		"noUncheckedIndexedAccess": true,
		"forceConsistentCasingInFileNames": true,
		"plugins": [
			{
				"name": "@effect/language-service",
				"diagnosticSeverity": {
					"newPromise": "off",
					"asyncFunction": "off",
					"nodeBuiltinImport": "off",
					"globalFetchInEffect": "off",
					"preferSchemaOverJson": "off",
					"globalDateInEffect": "error",
					"processEnvInEffect": "error",
					"globalTimersInEffect": "error",
					"globalConsoleInEffect": "error",
					"globalErrorInEffectFailure": "error"
				}
			}
		]
	}
}
