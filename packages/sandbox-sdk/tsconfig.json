{
	"exclude": ["dist", "tests"],
	"extends": "../../tsconfig.options.json",
	"compilerOptions": {
		"types": [],
		"strict": true,
		"outDir": "dist",
		"module": "preserve",
		"lib": ["ESNext", "DOM"],
		"verbatimModuleSyntax": true,
		"moduleResolution": "bundler",
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true
	}
}
