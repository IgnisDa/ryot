{
	"name": "@ryot-app/client-sdk",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./effect": {
			"types": "./src/effect.ts",
			"default": "./src/effect.ts"
		},
		"./plugin": {
			"types": "./src/plugin.tsx",
			"default": "./src/plugin.tsx"
		},
		"./react": {
			"types": "./src/react.tsx",
			"default": "./src/react.tsx"
		},
		"./schedule": {
			"types": "./src/schedule.ts",
			"default": "./src/schedule.ts"
		},
		"./ryotql": {
			"types": "./src/ryotql.ts",
			"default": "./src/ryotql.ts"
		},
		"./screen": {
			"types": "./src/plugin-screen.tsx",
			"default": "./src/plugin-screen.tsx"
		},
		"./testing": {
			"types": "./src/testing.ts",
			"default": "./src/testing.ts"
		}
	},
	"scripts": {
		"test": "bun --bun run vitest run",
		"check": "tsc && oxfmt . --write && oxlint . --type-aware --fix"
