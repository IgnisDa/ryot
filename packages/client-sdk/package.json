		"@ryot-app/ryotql": "workspace:*",
		"effect": "4.0.0-rc.111",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.0-beta.107",
		"@ryot-app/testing": "workspace:*",
		"@testing-library/dom": "^10.4.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"bun-types": "1.4.0",
		"jsdom": "^30.0.1",
		"typescript": "7.0.2",
		"vite": "^8.0.0",
		"vitest": "4.1.9"
	}
