{
	"name": "@ryot-app/i18n",
	"private": true,
	"exports": {
		"./*": {
			"types": "./src/*.ts",
			"default": "./src/*.ts"
		},
		"./react": {
			"types": "./src/react.tsx",
			"default": "./src/react.tsx"
		}
	},
	"scripts": {
		"test": "bun ../../packages/testing/src/run-client-tests.ts",
		"check": "bun --check && bun fmt . --write && oxlint . --fix"
	},
	"dependencies": {
		"@formatjs/icu-messageformat-parser": "3.5.22",
		"@ryot-app/ts-utils": "workspace:*",
		"@types/react": "19.3.0",
		"effect": "4.1.2",
		"intl-messageformat": "12.1.4",
		"react": "19.3.1"
	},
	"devDependencies": {
		"@ryot-app/testing": "workspace:*",
		"@testing-library/react": "16.3.3",
		"@types/react-dom": "19.3.0",
		"bun-types": "1.4.4",
		"jsdom": "30.1.3",
		"react-dom": "19.3.1"
	}
}
