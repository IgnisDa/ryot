{
	"name": "@ryot-app/kernel-messages",
	"private": true,
	"exports": {
		"./catalog": {
			"types": "./src/catalog.generated.ts",
			"default": "./src/catalog.generated.ts"
		},
		"./locales/*": {
			"types": "./src/locales/*.generated.ts",
			"default": "./src/locales/*.generated.ts"
		},
		"./message": {
			"types": "./src/message.ts",
			"default": "./src/message.ts"
		},
		"./testing": {
			"types": "./src/testing.ts",
			"default": "./src/testing.ts"
		}
	},
	"scripts": {
		"test": "bun ../../packages/testing/src/run-client-tests.ts",
		"build": "bun run tooling/build-catalogs.ts",
		"check": "bun --check && bun fmt . --write && oxlint . --fix"
	},
	"dependencies": {
		"@ryot-app/i18n": "workspace:*",
		"effect": "4.1.2"
	},
	"devDependencies": {
		"@effect/platform-bun": "4.1.2",
		"@ryot-app/testing": "workspace:*",
		"@voila.dev/effect-bun-test": "4.0.4",
		"bun-types": "1.4.4"
	}
}
