{
	"name": "@ryot-app/client-plugin-compiler",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./diagnostics": {
			"types": "./src/diagnostics.ts",
			"default": "./src/diagnostics.ts"
		},
		"./limits": {
			"types": "./src/limits.ts",
			"default": "./src/limits.ts"
		},
		"./protocol": {
			"types": "./src/protocol.ts",
			"default": "./src/protocol.ts"
		},
		"./worker": {
			"types": "./src/worker.ts",
			"default": "./src/worker.ts"
		}
	},
	"scripts": {
		"test": "bun --bun run vitest run",
		"check": "tsc && oxfmt . --write && oxlint . --type-aware --fix",
		"build": "tsc && bun build src/worker.ts --outdir dist --entry-naming client-plugin-compiler-worker.js --target bun --sourcemap --external @ryot-app/vite-compiler --external @tailwindcss/vite"
	},
	"dependencies": {
		"@effect/platform-bun": "4.0.0-rc.111",
		"@fontsource-variable/lora": "5.3.0",
		"@fontsource-variable/outfit": "5.3.0",
		"@ryot-app/client-plugin-contract": "workspace:*",
		"@ryot-app/client-sdk": "workspace:*",
		"@ryot-app/client-ui-sdk": "workspace:*",
		"@ryot-app/contract": "workspace:*",
		"@ryot-app/plugin-kit": "workspace:*",
		"@ryot-app/ryotql-recipes": "workspace:*",
		"@ryot-app/ts-utils": "workspace:*",
		"@ryot-app/typescript-compiler": "workspace:*",
		"@ryot-app/vite-compiler": "workspace:*",
		"@tailwindcss/vite": "4.3.0",
		"@tanstack/hotkeys": "0.8.0",
		"@tanstack/react-hotkeys": "0.10.0",
		"@tanstack/store": "0.11.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"clsx": "2.1.1",
		"effect": "4.0.0-rc.111",
		"lucide-react": "^1.37.0",
		"postcss": "^8.5.26",
		"postcss-value-parser": "^4.2.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "4.3.0",
		"typescript": "7.0.2",
		"vite": "8.0.14"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.0-rc.111",
		"@ryot-app/testing": "workspace:*",
		"@testing-library/dom": "^10.4.1",
		"@types/jsdom": "^30.0.0",
		"bun-types": "1.4.0",
		"jsdom": "^30.0.1",
		"vitest": "4.1.9"
	}
}
