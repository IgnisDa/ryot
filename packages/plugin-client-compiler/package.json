		"@ryot-app/ts-utils": "workspace:*",
		"@ryot-app/typescript-compiler": "workspace:*",
		"@ryot-app/vite-compiler": "workspace:*",
		"@tailwindcss/vite": "4.3.4",
		"@types/react": "19.2.15",
		"@types/react-dom": "19.2.3",
		"clsx": "2.1.1",
		"effect": "4.1.0",
		"postcss": "8.5.32",
