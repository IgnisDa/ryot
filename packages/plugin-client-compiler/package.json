{
	"name": "@ryot-app/plugin-client-compiler",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./diagnostics": {
			"types": "./src/diagnostics.ts",
			"default": "./src/diagnostics.ts"
		},
		"./limits": {
			"types": "./src/limits.ts",
			"default": "./src/limits.ts"
		}
	},
	"scripts": {
