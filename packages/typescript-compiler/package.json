{
	"name": "@ryot-app/typescript-compiler",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./javascript-references": {
			"types": "./src/javascript-references.ts",
			"default": "./src/javascript-references.ts"
		},
		"./typescript-references": {
			"types": "./src/typescript-references.ts",
			"default": "./src/typescript-references.ts"
		}
	},
	"scripts": {
		"test": "bun ../../packages/testing/src/run-tests.ts",
		"check": "bun --check && bun fmt . --write && oxlint . --fix"
	},
	"dependencies": {
		"@oxc-project/types": "0.156.0",
		"effect": "4.1.2",
		"rolldown": "1.2.16",
		"typescript": "7.0.2"
	},
	"devDependencies": {
		"@ryot-app/testing": "workspace:*",
		"@voila.dev/effect-bun-test": "4.0.4",
		"bun-types": "1.4.4"
	}
}
