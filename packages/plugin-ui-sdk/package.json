{
	"name": "@ryot-app/plugin-ui-sdk",
	"private": true,
	"type": "module",
	"exports": {
		"./markdown": {
			"types": "./src/markdown.tsx",
			"default": "./src/markdown.tsx"
		},
		"./theme.css": "./src/theme.css",
		"./palette.css": "./src/palette.css",
		"./schema-form": {
			"types": "./src/schema-form/index.tsx",
			"default": "./src/schema-form/index.tsx"
		},
		"./charts": {
			"types": "./src/charts.tsx",
			"default": "./src/charts.tsx"
		},
		"./table": {
			"types": "./src/table.tsx",
			"default": "./src/table.tsx"
		},
		"./icon": {
			"types": "./src/icon.tsx",
			"default": "./src/icon.tsx"
		},
		"./sync": {
			"types": "./src/sync.tsx",
			"default": "./src/sync.tsx"
		},
		"./tint": {
			"types": "./src/tint.tsx",
			"default": "./src/tint.tsx"
		},
		"./datetime": {
			"types": "./src/datetime.ts",
			"default": "./src/datetime.ts"
		},
		".": {
			"types": "./src/index.tsx",
			"default": "./src/index.tsx"
		}
	},
	"scripts": {
		"test": "bun ../../packages/testing/src/run-client-tests.ts",
		"check": "bun --check && bun fmt . --write && oxlint . --fix"
	},
	"dependencies": {
		"@ryot-app/contract": "workspace:*",
		"@ryot-app/ts-utils": "workspace:*",
		"@tanstack/charts": "1.2.1",
		"@tanstack/react-form": "2.0.0-alpha.3",
		"@tanstack/react-hotkeys": "0.22.0",
		"@types/mdast": "4.0.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"clsx": "2.1.1",
		"effect": "4.1.2",
		"lucide-react": "1.68.0",
		"mdast-util-directive": "3.2.0",
		"mdast-util-from-markdown": "2.1.0",
		"micromark-extension-directive": "4.0.0",
		"motion": "14.9.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-markdown": "10.1.0",
		"remark-directive": "4.0.0",
		"remark-gfm": "4.0.1"
	},
	"devDependencies": {
		"bun-types": "1.4.4",
		"@effect/platform-bun": "4.1.2",
		"@ryot-app/testing": "workspace:*",
		"@testing-library/react": "16.3.3",
		"@voila.dev/effect-bun-test": "4.0.4",
		"axe-core": "4.14.0",
		"jsdom": "30.1.3",
		"vite": "8.3.5"
	}
}
