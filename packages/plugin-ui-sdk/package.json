{
	"name": "@ryot-app/plugin-ui-sdk",
	"private": true,
	"type": "module",
	"exports": {
		"./markdown": {
			"types": "./src/markdown.tsx",
			"default": "./src/markdown.tsx"
		},
		"./theme.css": "./src/theme.css",
		"./palette.css": "./src/palette.css",
		"./schema-form": {
			"types": "./src/schema-form/index.tsx",
			"default": "./src/schema-form/index.tsx"
		},
		"./charts": {
			"types": "./src/charts.tsx",
			"default": "./src/charts.tsx"
		},
		"./table": {
			"types": "./src/table.tsx",
			"default": "./src/table.tsx"
		},
		"./icon": {
			"types": "./src/icon.tsx",
			"default": "./src/icon.tsx"
		},
		"./sync": {
			"types": "./src/sync.tsx",
			"default": "./src/sync.tsx"
		},
		"./tint": {
			"types": "./src/tint.tsx",
			"default": "./src/tint.tsx"
		},
		".": {
			"types": "./src/index.tsx",
			"default": "./src/index.tsx"
		}
	},
	"scripts": {
		"test": "bun --bun run vitest run",
		"check": "bun --check && oxfmt . --write && oxlint . --fix"
	},
	"dependencies": {
		"@ryot-app/contract": "workspace:*",
		"@tanstack/charts": "0.18.0",
		"@tanstack/react-form": "2.0.0-alpha.1",
		"@tanstack/react-hotkeys": "0.10.0",
		"@tanstack/react-table": "9.1.2",
		"@types/hast": "3.0.4",
		"@types/mdast": "4.0.4",
		"clsx": "2.1.1",
		"effect": "4.0.5",
		"lucide-react": "^1.37.0",
		"mdast-util-directive": "3.1.1",
		"mdast-util-from-markdown": "2.1.0",
		"micromark-extension-directive": "4.0.0",
		"motion": "^13.1.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-markdown": "10.1.0",
		"remark-directive": "4.0.0"
	},
	"devDependencies": {
		"@effect/platform-bun": "4.0.5",
		"@effect/vitest": "4.0.5",
		"@ryot-app/testing": "workspace:*",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"jsdom": "^30.0.1",
		"vite": "^8.0.0",
		"vitest": "4.1.9",
		"vitest-axe": "^0.1.0"
	}
}
