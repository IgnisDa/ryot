{
	"env": { "node": true, "browser": true },
	"jsPlugins": ["eslint-plugin-perfectionist"],
	"settings": { "react": { "version": "19.0.0" } },
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
	"categories": { "perf": "warn", "suspicious": "warn", "correctness": "error" },
	"plugins": ["react", "typescript", "unicorn", "import", "oxc", "node", "promise"],
	"ignorePatterns": [
		"**/out/**",
		"**/dist/**",
		"**/.wxt/**",
		"**/build/**",
		"**/.vitepress/**",
		"apps/frontend/app/styles/*.css",
		"**/lib/infrastructure/sandbox-runtime/*.sandbox.ts"
	],
	"rules": {
		"curly": "error",
		"no-else-return": "warn",
		"import/no-cycle": "error",
		"react-in-jsx-scope": "off",
		"eqeqeq": ["error", "smart"],
		"no-param-reassign": "error",
		"default-param-last": "error",
		"unicorn/no-array-sort": "off",
		"react/rules-of-hooks": "error",
		"import/no-duplicates": "error",
		"import/no-self-import": "error",
		"promise/no-return-wrap": "error",
		"effecttsgo/new-promise": "error",
		"effecttsgo/any-unknown-in-error-context": "error",
		"effecttsgo/strict-effect-provide": "warn",
		"effecttsgo/unsafe-effect-type-assertion": "error",
		"react/self-closing-comp": "error",
		"typescript/require-await": "warn",
		"react/no-array-index-key": "warn",
		"typescript/no-deprecated": "error",
		"eslint/no-nested-ternary": "error",
		"import/no-named-as-default": "off",
		"typescript/no-explicit-any": "warn",
		"typescript/await-thenable": "error",
		"effecttsgo/async-function": "error",
		"typescript/prefer-as-const": "error",
		"react-hooks/exhaustive-deps": "error",
		"typescript/only-throw-error": "error",
		"import/newline-after-import": "error",
		"react/jsx-no-useless-fragment": "warn",
		"react/jsx-curly-brace-presence": "warn",
		"typescript/no-misused-promises": "error",
		"typescript/no-inferrable-types": "error",
		"effecttsgo/node-builtin-import": "error",
		"typescript/prefer-optional-chain": "warn",
		"typescript/no-floating-promises": "error",
		"typescript/no-non-null-assertion": "warn",
		"import/first": ["error", "absolute-first"],
		"unicorn/prefer-number-properties": "error",
		"effecttsgo/global-date-in-effect": "error",
		"effecttsgo/process-env-in-effect": "error",
		"unicorn/no-await-expression-member": "warn",
		"typescript/consistent-type-imports": "warn",
		"effecttsgo/global-fetch-in-effect": "error",
		"typescript/no-unnecessary-condition": "warn",
		"effecttsgo/global-timers-in-effect": "error",
		"effecttsgo/prefer-schema-over-json": "error",
		"typescript/prefer-nullish-coalescing": "warn",
		"typescript/prefer-enum-initializers": "error",
		"effecttsgo/global-console-in-effect": "error",
		"typescript/no-import-type-side-effects": "warn",
		"react/jsx-no-constructed-context-values": "warn",
		"typescript/switch-exhaustiveness-check": "error",
		"typescript/no-unnecessary-type-assertion": "warn",
		"effecttsgo/global-error-in-effect-failure": "error",
		"eslint/no-underscore-dangle": ["error", { "allow": ["_tag"] }],
		"typescript/no-unused-vars": [
			"error",
			{ "varsIgnorePattern": "^_", "argsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
		],
		"perfectionist/sort-objects": [
			"error",
			{ "type": "line-length", "order": "asc", "partitionByNewLine": true }
		],
		"perfectionist/sort-jsx-props": [
			"error",
			{ "type": "line-length", "order": "asc", "partitionByNewLine": true }
		],
		"no-restricted-properties": [
			"error",
			{
				"property": "toSorted",
				"message": "Array.prototype.toSorted is not supported in Hermes (React Native). Use sortBy from @ryot-app/ts-utils instead."
			},
			{
				"object": "vi",
				"property": "mock",
				"message": "Do not mock modules. Inject dependencies through Effect Layers or a package test surface."
			},
			{
				"object": "vi",
				"property": "doMock",
				"message": "Do not mock modules. Inject dependencies through Effect Layers or a package test surface."
			},
			{
				"object": "vi",
				"property": "hoisted",
				"message": "vi.hoisted exists to support module mocks. Inject dependencies instead."
			},
			{
				"object": "vi",
				"property": "spyOn",
				"message": "Do not spy on application code or globals. Pass a recording function at the injected seam."
			},
			{
				"object": "vi",
				"property": "fn",
				"message": "Do not use mock functions. Pass a plain recording function at the injected seam."
			},
			{
				"object": "vi",
				"property": "useFakeTimers",
				"message": "Do not fake timers. Schedule through an injected clock and drive it with TestClock."
			},
			{
				"object": "vi",
				"property": "setSystemTime",
				"message": "Do not set system time. Read time from an injected clock and drive it with TestClock."
			}
		]
	},
	"overrides": [
		{
			"files": ["apps/browser-extension/src/**"],
			"rules": { "effecttsgo/async-function": "warn", "effecttsgo/new-promise": "warn" }
		},
		{ "files": ["apps/website/app/**"], "rules": { "effecttsgo/async-function": "warn" } },
		{
			"files": ["apps/website/app/lib/caches.server.ts", "apps/website/app/routes/health.tsx"],
			"rules": { "effecttsgo/node-builtin-import": "warn" }
		},
		{
			"files": ["kernel/backend/src/**", "kernel/backend/scripts/sandbox-runtime-inputs.test.ts"],
			"rules": { "effecttsgo/any-unknown-in-error-context": "warn" }
		},
		{
			"files": ["kernel/client/src/**"],
			"rules": {
				"effecttsgo/any-unknown-in-error-context": "warn",
				"effecttsgo/async-function": "warn",
				"effecttsgo/global-date-in-effect": "warn",
				"effecttsgo/global-error-in-effect-failure": "warn",
				"effecttsgo/global-fetch-in-effect": "warn",
				"effecttsgo/new-promise": "warn",
				"effecttsgo/prefer-schema-over-json": "warn"
			}
		},
		{
			"files": ["kernel/client/scripts/generate-assets.ts"],
			"rules": { "effecttsgo/node-builtin-import": "warn" }
		},
		{
			"files": ["packages/cli/src/index.ts"],
			"rules": {
				"effecttsgo/global-date-in-effect": "warn",
				"effecttsgo/prefer-schema-over-json": "warn"
			}
		},
		{
			"files": ["packages/cli/src/index.test.ts"],
			"rules": {
				"effecttsgo/any-unknown-in-error-context": "warn",
				"effecttsgo/global-error-in-effect-failure": "warn",
				"effecttsgo/prefer-schema-over-json": "warn"
			}
		},
		{
			"files": ["packages/client-plugin-compiler/src/**"],
			"rules": {
				"effecttsgo/async-function": "warn",
				"effecttsgo/node-builtin-import": "warn",
				"effecttsgo/prefer-schema-over-json": "warn"
			}
		},
		{
			"files": ["packages/client-sdk/src/**"],
			"rules": {
				"effecttsgo/async-function": "warn",
				"effecttsgo/global-error-in-effect-failure": "warn",
				"effecttsgo/new-promise": "warn"
			}
		},
		{
			"files": ["packages/client-ui-sdk/src/**"],
			"rules": { "effecttsgo/async-function": "warn", "effecttsgo/new-promise": "warn" }
		},
		{
			"files": ["packages/client-ui-sdk/src/palette-contrast.test.ts"],
			"rules": { "effecttsgo/node-builtin-import": "warn" }
		},
		{
			"files": ["packages/kernel-renderers/src/**"],
			"rules": { "effecttsgo/async-function": "warn", "effecttsgo/new-promise": "warn" }
		},
		{
			"files": ["packages/kernel-renderers/scripts/generate-sources.ts"],
			"rules": { "effecttsgo/async-function": "warn" }
		},
		{
			"files": [
				"packages/plugin-archive/src/index.ts",
				"packages/plugin-archive/src/index.test.ts"
			],
			"rules": { "effecttsgo/async-function": "warn", "effecttsgo/node-builtin-import": "warn" }
		},
		{
			"files": ["packages/sandbox-sdk/src/**", "packages/sandbox-sdk/tests/**"],
			"rules": {
				"effecttsgo/any-unknown-in-error-context": "warn",
				"effecttsgo/async-function": "warn",
				"effecttsgo/global-error-in-effect-failure": "warn"
			}
		},
		{
			"files": ["packages/sandbox-sdk/tests/youtubei.test.ts"],
			"rules": { "effecttsgo/prefer-schema-over-json": "warn" }
		},
		{
			"files": ["packages/testing/src/postgres-container.ts"],
			"rules": { "effecttsgo/async-function": "warn", "effecttsgo/node-builtin-import": "warn" }
		},
		{
			"files": ["packages/vite-compiler/src/**"],
			"rules": {
				"effecttsgo/any-unknown-in-error-context": "warn",
				"effecttsgo/async-function": "warn",
				"effecttsgo/node-builtin-import": "warn",
				"effecttsgo/prefer-schema-over-json": "warn"
			}
		},
		{
			"files": ["plugins/fixture/backend/lib/**"],
			"rules": {
				"effecttsgo/global-error-in-effect-failure": "warn",
				"effecttsgo/prefer-schema-over-json": "warn"
			}
		},
		{
			"files": ["plugins/fixture/backend/providers/**"],
			"rules": { "effecttsgo/global-error-in-effect-failure": "warn" }
		},
		{ "files": ["plugins/fixture/client/**"], "rules": { "effecttsgo/async-function": "warn" } },
		{
			"files": ["plugins/fitness/backend/**"],
			"rules": {
				"effecttsgo/any-unknown-in-error-context": "warn",
				"effecttsgo/async-function": "warn",
				"effecttsgo/global-error-in-effect-failure": "warn",
				"effecttsgo/prefer-schema-over-json": "warn"
			}
		},
		{ "files": ["plugins/fitness/client/**"], "rules": { "effecttsgo/async-function": "warn" } },
		{
			"files": ["plugins/media/backend/**"],
			"rules": {
				"effecttsgo/any-unknown-in-error-context": "warn",
				"effecttsgo/async-function": "warn",
				"effecttsgo/global-date-in-effect": "warn",
				"effecttsgo/global-error-in-effect-failure": "warn",
				"effecttsgo/prefer-schema-over-json": "warn"
			}
		},
		{
			"files": ["plugins/media/client/**", "plugins/media/tests/client/**"],
			"rules": { "effecttsgo/async-function": "warn", "effecttsgo/new-promise": "warn" }
		}
	]
}
