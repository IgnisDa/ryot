{
	"name": "@ryot/sandbox-sdk",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./testing": {
			"types": "./src/testing.ts",
			"default": "./src/testing.ts"
		}
