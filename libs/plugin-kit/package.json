{
	"name": "@ryot/plugin-kit",
	"private": true,
	"exports": {
		"./manifest": {
			"types": "./src/manifest.ts",
			"default": "./src/manifest.ts"
		},
		"./operations": {
			"types": "./src/operations.ts",
			"default": "./src/operations.ts"
		}
	},
	"scripts": {
		"build": "tsc",
