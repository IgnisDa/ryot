	},
	"dependencies": {
		"@ryot/contract": "workspace:*",
		"@ryot/sandbox-sdk": "workspace:*",
		"effect": "3.21.4"
	},
	"devDependencies": {
		"bun-types": "1.3.14"
	}
}
